COCKROACHDB_URL=postgresql://root@localhost:26257/omninpc?sslmode=disable

# dialogue provider: lmstudio | gemini | bedrock
LLM_PROVIDER=lmstudio

# local LM Studio server, no quota. host.docker.internal reaches the host from the
# container; use http://localhost:1234 when running the backend outside Docker.
LM_STUDIO_BASE_URL=http://host.docker.internal:1234
LM_STUDIO_API_KEY=
LM_STUDIO_MODEL_ID=google/gemma-4-12b

# hosted Gemini. Free tier allows only 20 requests per day per model.
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# Bedrock dialogue settings. Embeddings still use the local sentence-transformer.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_DIALOGUE_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
