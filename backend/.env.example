COCKROACHDB_URL=postgresql://root@localhost:26257/omninpc?sslmode=disable

# Dialogue provider: gemini | bedrock
LLM_PROVIDER=bedrock

# Use the alternate provider when dialogue generation fails.
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=gemini

# Gemini dialogue configuration
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# Embedding provider: bedrock | local. The schema's VECTOR width must match.
EMBEDDING_PROVIDER=bedrock

# Amazon Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_DIALOGUE_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Titan V2 accepts 1024, 512, or 256
BEDROCK_EMBEDDING_DIMENSIONS=1024

# When set, operator routes require this value in X-Admin-Key.
ADMIN_API_KEY=
